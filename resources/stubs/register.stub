<?php

namespace App\Filament\Pages\Auth;

use Eii\FilamentTurnstile\Forms\Components\Turnstile;
use Filament\Auth\Pages\Register;
use Filament\Schemas\Schema;

class TurnstileRegister extends Register
{
    public function form(Schema $schema): Schema
    {
        return $schema
            ->components([
                $this->getNameFormComponent(),
                $this->getEmailFormComponent(),
                $this->getPasswordFormComponent(),
                $this->getPasswordConfirmationFormComponent(),
                Turnstile::make('turnstile_token')
                    ->label('Security Verification')
                    ->turnstileAction((string) config('filament-turnstile.actions.register', 'admin-register'))
                    ->theme((string) config('filament-turnstile.theme', 'auto'))
                    ->size((string) config('filament-turnstile.size', 'normal'))
                    ->appearance((string) config('filament-turnstile.appearance', 'always'))
                    ->columnSpanFull(),
            ])
            ->statePath('data');
    }
}
