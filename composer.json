{
  "name": "eii/filament-turnstile",
  "description": "Cloudflare Turnstile integration for Filament 5 forms.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/http": "^11.28|^12.0|^13.0",
    "illuminate/support": "^11.28|^12.0|^13.0",
    "filament/forms": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "Eii\\FilamentTurnstile\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Eii\\FilamentTurnstile\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Eii\\FilamentTurnstile\\TurnstileServiceProvider"
      ]
    }
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.0"
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
